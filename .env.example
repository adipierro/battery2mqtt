# Non-secret settings used by compose.yaml
MQTT_BROKER_HOST=mqtt.example.internal
# MQTT_BROKER_PORT=1883
MQTT_BROKER_TLS=false
# Defaults to the machine hostname. Set this when running in a container if needed.
# MQTT_DEVICE_NAME=workstation
MQTT_TOPIC_PREFIX=data
HOME_ASSISTANT_DISCOVERY_ENABLED=true
HOME_ASSISTANT_DISCOVERY_PREFIX=homeassistant
